{
  "version": 1,
  "tickers": ["AVT", "CSTM", "GOOGL", "LUNR", "RDW", "VST"],
  "selection": {
    "perTicker": ["as_of DESC", "id DESC"],
    "rowOrder": ["ticker ASC"]
  },
  "canonicalization": {
    "timestamp": "UTC milliseconds, YYYY-MM-DDTHH:mm:ss.SSSZ",
    "date": "YYYY-MM-DD",
    "moneyScale": 2,
    "priceScale": 4,
    "sharesEpsGrowthScale": 6,
    "nullToken": "#NULL#",
    "nonNullToken": "UTF-8 bytes encoded as lowercase hex",
    "fieldSeparator": ":",
    "rowSeparator": "LF",
    "terminalRowSeparator": true,
    "hash": "SHA-256"
  },
