# cp .env.example .env, then replace every CHANGE_ME value.
POSTGRES_PASSWORD=CHANGE_ME
CREDENTIAL_KEY_BASE64=CHANGE_ME_BASE64_32_BYTES

POSTGRES_PORT=5432
REDIS_PORT=6379
ANALYSIS_PORT=8000
BACKEND_PORT=8080
DASHBOARD_PORT=3000
OIDC_MOCK_PORT=9090
TOSS_MOCK_PORT=9091

ANALYSIS_CONNECT_TIMEOUT=PT2S
ANALYSIS_READ_TIMEOUT=PT5S
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-2.5-flash
GEMINI_PROMPT_VERSION=stock-analysis-explain-v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_CONNECT_TIMEOUT=PT2S
GEMINI_READ_TIMEOUT=PT10S
TOSS_CONNECT_TIMEOUT=PT2S
TOSS_READ_TIMEOUT=PT5S

# Stock-analysis providers are opt-in. Set one STOCK_ANALYSIS_<PROVIDER>_ENABLED=true
# only after supplying its complete `stock-analysis.providers.<provider>` config
# (base-url, path, fields, auth/query settings, and policy) in the active YAML profile.
STOCK_ANALYSIS_RUNNING_TIMEOUT=PT5M

# Scheduled prediction grading is opt-in.
PREDICTION_EVALUATION_ENABLED=false
PREDICTION_EVALUATION_INTERVAL=PT1H
PREDICTION_EVALUATION_INITIAL_DELAY=PT1M
PREDICTION_EVALUATION_LOCK_TTL=PT10M
PREDICTION_EVALUATION_BATCH_SIZE=100
PREDICTION_EVALUATION_MAX_PER_TICK=1000
PREDICTION_EVALUATION_MAX_RUNTIME=PT5M
PREDICTION_EVALUATION_METRICS_CACHE_TTL=PT30S
PREDICTION_EVALUATION_LONG_UNGRADED_AFTER=PT24H
PREDICTION_FORECAST_QUALITY_MINIMUM_SAMPLE_COUNT=10

# Notification outbox drain is opt-in. Without it nothing consumes
# notification_outbox_events, so no notifications are ever delivered. Enable it together
# with ORDER_OUTBOX_ENABLED below: the order relay only produces rows for this drain.
NOTIFICATION_OUTBOX_ENABLED=false
NOTIFICATION_OUTBOX_INTERVAL=PT2S
NOTIFICATION_OUTBOX_INITIAL_DELAY=PT2S
NOTIFICATION_OUTBOX_BATCH_SIZE=50

# Order outbox relay (async fan-out of order events, e.g. terminal transitions to
# notifications) is opt-in. MAX_ATTEMPTS is the retry cap before a row is dead-lettered.
ORDER_OUTBOX_ENABLED=false
ORDER_OUTBOX_INTERVAL=PT2S
ORDER_OUTBOX_INITIAL_DELAY=PT2S
ORDER_OUTBOX_BATCH_SIZE=50
ORDER_OUTBOX_MAX_ATTEMPTS=5

# Per-key distributed limit for API-key-authenticated prediction batches.
PREDICTION_INGESTION_API_KEY_RATE_LIMIT_LIMIT=60
PREDICTION_INGESTION_API_KEY_RATE_LIMIT_WINDOW=PT1M
PREDICTION_INGESTION_API_KEY_CLEANUP_ENABLED=true
PREDICTION_INGESTION_API_KEY_CLEANUP_INTERVAL=PT1H
PREDICTION_INGESTION_API_KEY_CLEANUP_INITIAL_DELAY=PT1M

# Used only with compose.dev.yaml.
PUBLIC_DASHBOARD_URL=http://localhost:3000
OIDC_CLIENT_ID=CHANGE_ME
OIDC_CLIENT_SECRET=CHANGE_ME
OIDC_ISSUER_URI=https://CHANGE_ME
TOSS_BASE_URL=https://openapi.tossinvest.com

# Real-order canary is disabled unless every setting below is explicitly supplied.
# The canary hard ceilings are 10 shares, KRW 100,000, USD 100, and quote age 5 minutes;
# the configured limits must be no larger than those ceilings and the account must be in
# real_order_account_allowlist with enabled=true. Missing credentials/config returns preflight only.
REAL_ORDER_ENABLED=false
REAL_ORDER_CANARY_ENABLED=false
# REAL_ORDER_CANARY_CONNECTION_ID=CHANGE_ME_UUID
# REAL_ORDER_CANARY_BROKER_ACCOUNT_ID=CHANGE_ME_UUID
# REAL_ORDER_CANARY_MAX_QUANTITY=1
# REAL_ORDER_CANARY_MAX_ORDER_AMOUNT_KRW=100000
# REAL_ORDER_CANARY_MAX_ORDER_AMOUNT_USD=100
# REAL_ORDER_CANARY_QUOTE_MAX_AGE=PT30S
# REAL_ORDER_CANARY_CLIENT_ORDER_ID_PREFIX=canary
