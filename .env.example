# cp .env.example .env, then replace every CHANGE_ME value.
POSTGRES_PASSWORD=CHANGE_ME
CREDENTIAL_KEY_BASE64=CHANGE_ME_BASE64_32_BYTES

POSTGRES_PORT=5432
REDIS_PORT=6379
ANALYSIS_PORT=8000
BACKEND_PORT=8080
DASHBOARD_PORT=3000
OIDC_MOCK_PORT=9090
TOSS_MOCK_PORT=9091

ANALYSIS_CONNECT_TIMEOUT=PT2S
ANALYSIS_READ_TIMEOUT=PT5S
TOSS_CONNECT_TIMEOUT=PT2S
TOSS_READ_TIMEOUT=PT5S

# Used only with compose.dev.yaml.
PUBLIC_DASHBOARD_URL=http://localhost:3000
OIDC_CLIENT_ID=CHANGE_ME
