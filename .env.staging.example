# cp .env.staging.example .env.staging, then fill in every CHANGE_ME value.
# Used only with compose.staging.yaml, layered on top of .env (or its own equivalents).
#
# The Postgres password never goes here as a value — compose.staging.yaml reads it from
# a FILE via STAGING_DB_PASSWORD_FILE (Postgres's own POSTGRES_PASSWORD_FILE bootstrap,
# and the backend's spring.datasource.password via Spring Boot's Config Tree feature).
STAGING_DB_PASSWORD_FILE=CHANGE_ME_path_to_a_file_containing_the_password

# Pinned image tags. Point these at a real registry for an actual deploy; leave unset to
# fall back to the locally built :staging tag (what the deploy/rollback drill uses).
BACKEND_IMAGE=CHANGE_ME_registry/trade-backend:CHANGE_ME_tag
ANALYSIS_IMAGE=CHANGE_ME_registry/trade-analysis:CHANGE_ME_tag
DASHBOARD_IMAGE=CHANGE_ME_registry/trade-dashboard:CHANGE_ME_tag

# Scheduled prediction grading is opt-in.
PREDICTION_EVALUATION_ENABLED=false
PREDICTION_EVALUATION_INTERVAL=PT1H
PREDICTION_EVALUATION_INITIAL_DELAY=PT1M
PREDICTION_EVALUATION_LOCK_TTL=PT10M
PREDICTION_EVALUATION_BATCH_SIZE=100
PREDICTION_EVALUATION_MAX_PER_TICK=1000
PREDICTION_EVALUATION_MAX_RUNTIME=PT5M
PREDICTION_EVALUATION_METRICS_CACHE_TTL=PT30S

# Resource limits (memory + cpus). Defaults are sized for a single-node staging box;
# override any of these if that doesn't fit your environment.
STAGING_POSTGRES_MEMORY_LIMIT=512m
STAGING_POSTGRES_CPU_LIMIT=0.5
STAGING_REDIS_MEMORY_LIMIT=128m
STAGING_REDIS_CPU_LIMIT=0.25
STAGING_ANALYSIS_MEMORY_LIMIT=256m
STAGING_ANALYSIS_CPU_LIMIT=0.5
STAGING_MIGRATE_MEMORY_LIMIT=384m
STAGING_MIGRATE_CPU_LIMIT=0.5
STAGING_BACKEND_MEMORY_LIMIT=768m
STAGING_BACKEND_CPU_LIMIT=1.0
STAGING_DASHBOARD_MEMORY_LIMIT=256m
STAGING_DASHBOARD_CPU_LIMIT=0.5
