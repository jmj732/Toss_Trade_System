{
  "request": {
    "method": "GET",
    "urlPath": "/api/v1/sellable-quantity",
    "queryParameters": {
      "symbol": {
        "matches": "^[A-Za-z0-9._:-]+$"
      }
    },
    "headers": {
      "Authorization": {
        "matches": "^Bearer .+$"
      },
      "X-Tossinvest-Account": {
        "matches": "^.+$"
      }
    }
  },
  "response": {
    "status": 200,
    "jsonBody": {
      "result": {
        "sellableQuantity": "0"
      }
    },
    "headers": {
      "Content-Type": "application/json",
      "X-Request-Id": "local-toss-mock"
    }
  }
}
